# =================================================================
# ShadowWall AI - Environment Configuration Template
# =================================================================
# Copy this file to '.env' and add your Google AI Studio API key.
# Get a free Gemini API key from: https://aistudio.google.com/app/apikey
# =================================================================

# Google Gemini AI API Key (REQUIRED for Live AI Chatbot & Deep Threat Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (default: gemini-1.5-flash)
# Supported models: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# Optional Third-Party Threat Intelligence API Keys
SAFE_BROWSING_API_KEY=your_safe_browsing_key_here
VIRUSTOTAL_API_KEY=your_virustotal_key_here
